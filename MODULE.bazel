"""Bazel module for chromeos/audio-tests.

Builds the static demo pages and the two JavaScript subprojects into the site
tree that is published to https://chromeos.github.io/audio-tests/.
"""

module(
    name = "audio_tests",
    version = "0.0.0",
)

# copy_to_directory, used to assemble the published site.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# JavaScript toolchain and npm dependency resolution.
bazel_dep(name = "aspect_rules_js", version = "3.3.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")

# pnpm-lock.yaml is the authoritative lockfile and is read natively by rules_js,
# so no repository rule writes into the source tree during a build. pnpm is the
# package manager for this subproject; see packageManager in its package.json.
npm.npm_translate_lock(
    name = "npm_aecdump_viewer",
    pnpm_lock = "//src/aecdump-viewer:pnpm-lock.yaml",
)
use_repo(npm, "npm_aecdump_viewer")

# @material/web's .d.ts files import lit-html directly while declaring only lit,
# so its types do not resolve under pnpm's strict layout. npm's flat hoisting
# masked this. Hoist that one package rather than declaring someone else's
# missing dependency in our own manifest.
npm.npm_translate_lock(
    name = "npm_ds_playground",
    pnpm_lock = "//src/ds-playground:pnpm-lock.yaml",
    public_hoist_packages = {
        "lit-html": ["src/ds-playground"],
    },
)
use_repo(npm, "npm_ds_playground")

# Playwright browsers, fetched by Bazel rather than by a post-install step.
# Pinned below the 1.57 Chrome-for-Testing cliff: rules_playwright 0.5.3 only
# generates the legacy builds/chromium/<revision>/ download paths, which stop
# resolving for 1.57+ on x64. browsers.json is vendored from playwright-core so
# the revision is a committed input rather than an unhashed unpkg fetch.
bazel_dep(name = "rules_playwright", version = "0.5.3")

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_json = "//src/aecdump-viewer:browsers.json",
)
use_repo(playwright, "playwright")
