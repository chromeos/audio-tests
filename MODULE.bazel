"""Bazel module for chromeos/audio-tests.

Builds the static demo pages and the two JavaScript subprojects into the site
tree that is published to https://chromeos.github.io/audio-tests/.
"""

module(
    name = "audio_tests",
    version = "0.0.0",
)

# copy_to_directory, used to assemble the published site.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# JavaScript toolchain and npm dependency resolution.
bazel_dep(name = "aspect_rules_js", version = "3.3.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")

# pnpm-lock.yaml is the authoritative lockfile and is read natively by rules_js,
# so no repository rule writes into the source tree during a build. pnpm is the
# package manager for this subproject; see packageManager in its package.json.
npm.npm_translate_lock(
    name = "npm_aecdump_viewer",
    pnpm_lock = "//src/aecdump-viewer:pnpm-lock.yaml",
)
use_repo(npm, "npm_aecdump_viewer")
