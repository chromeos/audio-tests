load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")

# The published site tree, equivalent to what the GitHub Actions workflow
# assembles into out/ before uploading it to gh-pages.
# Adding a demo means adding its target here.
copy_to_directory(
    name = "site",
    srcs = [
        "src/index.html",
        "//src/aecdump-viewer:bundle",
        "//src/audio-tuning:files",
        "//src/ds-playground:bundle",
        "//src/mic-testing:files",
        "//src/pwa-audio-recorder:files",
        "//src/screen-capture-test:files",
        "//src/volume-tuning:files",
    ],
    # Static demos keep their directory name; the two bundled subprojects are
    # published from their dist/ directory under the subproject's own name.
    replace_prefixes = {
        "aecdump-viewer/dist": "aecdump-viewer",
        "ds-playground/dist": "ds-playground",
    },
    # Site paths are relative to src/, so src/mic-testing/x -> mic-testing/x.
    root_paths = ["src"],
    visibility = ["//visibility:public"],
)
