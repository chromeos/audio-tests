load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")

# The published site tree, equivalent to what the GitHub Actions workflow
# assembles into out/ before uploading it to gh-pages.
# Adding a demo means adding its target here.
copy_to_directory(
    name = "site",
    srcs = [
        "src/index.html",
        "//src/aecdump-viewer:bundle",
        "//src/audio-tuning:files",
        "//src/ds-playground:bundle",
        "//src/mic-testing:files",
        "//src/pwa-audio-recorder:files",
        "//src/screen-capture-test:files",
        "//src/volume-tuning:files",
    ],
    # Static demos keep their directory name; the two bundled subprojects are
    # published from their dist/ directory under the subproject's own name.
    replace_prefixes = {
        "aecdump-viewer/dist": "aecdump-viewer",
        "ds-playground/dist": "ds-playground",
    },
    # Site paths are relative to src/, so src/mic-testing/x -> mic-testing/x.
    root_paths = ["src"],
    visibility = ["//visibility:public"],
)

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")

# Materializes //:site into out/ for the CI artifact upload: `bazel run //:stage_site`.
# Used as a directory-copy primitive rather than for its usual round-tripping
# purpose, so the staleness test and the destination-exists check are off -- out/
# is build output, not something checked in. Unlike a shell copy this writes
# 644/755 without post-hoc chmod, does not reach into the bazel-bin symlink, and
# removes files that are no longer part of the site.
write_source_files(
    name = "stage_site",
    files = {"out": "//:site"},
    check_that_out_file_exists = False,
    diff_test = False,
)
