{
  "name": "aecdump-viewer",
  "description": "Web-based AECDump Viewer",
  "license": "Apache-2.0",
  "author": "aaronyu",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm run proto:generate && tsc && vite build",
    "start": "pnpm run proto:generate && vite",
    "serve:dist": "vite preview --port ${PREVIEW_PORT:-8080} --strictPort",
    "serve:dev": "vite --port 8000",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --dir tests/unit",
    "test:e2e": "playwright test",
    "test:dev": "TEST_ENV=dev playwright test",
    "proto:generate": "pbjs -t static-module -w es6 -o src/proto/debug.js src/proto/debug.proto && pbts -o src/proto/debug.d.ts src/proto/debug.js",
    "fixtures:generate": "vite-node tests/fixtures/generate.ts"
  },
  "dependencies": {
    "lit": "^3.1.1",
    "long": "^5.3.2",
    "protobufjs": "^7.2.4",
    "wavesurfer.js": "^7.7.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@types/node": "^22",
    "protobufjs-cli": "^1.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^2"
  }
}
